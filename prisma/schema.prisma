generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id          String       @id @default(cuid())
  name        String
  categoryId  String
  category    Category     @relation(fields: [categoryId], references: [id])
  station     String       @default("Ninguna")
  price       Decimal      @default(0) @db.Decimal(12, 2)
  emoji       String       @default("🍔")
  prepMinutes Int          @default(15)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  inventory   InventoryItem?
}

model InventoryItem {
  id           String             @id @default(cuid())
  name         String
  type         InventoryType      @default(RAW)
  unit         String             @default("UNIDAD")
  currentStock Decimal            @default(0) @db.Decimal(12, 3)
  minStock     Decimal            @default(0) @db.Decimal(12, 3)
  cost         Decimal            @default(0) @db.Decimal(12, 2)
  expiresAt    DateTime?
  perishable   Boolean            @default(false)
  productId    String?            @unique
  product      Product?           @relation(fields: [productId], references: [id])
  movements    InventoryMovement[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

enum InventoryType {
  RAW
  FINISHED
}

model InventoryMovement {
  id        String        @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id])
  quantity  Decimal       @db.Decimal(12, 3)
  reason    String
  createdAt DateTime      @default(now())
}
